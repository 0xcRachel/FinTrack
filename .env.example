# =====================================================================
# FinTrack — local environment template. PLACEHOLDERS ONLY, no secrets.
# Copy to .env (git-ignored) and fill in local values.
# =====================================================================

# ---- MySQL (Laragon local instance) ----
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=fintrack
DB_USER=fintrack
DB_PASSWORD=change-me

# ---- Backend ----
BACKEND_PORT=8080
# Generate e.g.: openssl rand -base64 48
JWT_SECRET=change-me-to-a-long-random-secret-min-256-bits
JWT_EXPIRATION_MS=1800000

# ---- Frontend (Vite) ----
VITE_API_BASE_URL=http://127.0.0.1:8080/api/v1
